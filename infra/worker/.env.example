# Copie para infra/worker/.env no host (fora do Git, chmod 600). Nunca commite o .env.
# Valores do ambiente alvo; staging e produção têm chaves próprias.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Decifra a credencial da conexão Chatwoot (worker de envio). Igual à da aplicação.
ENCRYPTION_KEY=

# Sem batida do laço por este tempo, o processo sai e o Docker reinicia.
WORKER_WATCHDOG_SECONDS=300

# Kill switches. Ligar exige autorização e o corte do backlog (instante ISO, UTC).
CHATWOOT_INBOX_WORKER_ENABLED=false
CHATWOOT_INBOX_WORKER_BACKLOG_DESDE=
CHATWOOT_SEND_WORKER_ENABLED=false
CHATWOOT_SEND_WORKER_BACKLOG_DESDE=
