# Copie para infra/chatwoot-vm/.env no host (fora do Git, chmod 600).
# Gere cada segredo com: openssl rand -hex 32
CHATWOOT_DOMAIN=chat.exemplo.com.br
ACME_EMAIL=operacao@exemplo.com.br
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_POSTGRES_PASSWORD=
CHATWOOT_REDIS_PASSWORD=

# Opcional: e-mail de convite e recuperação de senha.
CHATWOOT_MAILER_SENDER=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Backup (backup.sh). BACKUP_RCLONE_REMOTE vazio = só cópia local, que não vale como backup externo.
BACKUP_DIR=/var/backups/chatwoot
BACKUP_RETENTION_DAYS=7
BACKUP_RCLONE_REMOTE=
