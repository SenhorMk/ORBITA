# never committed; manifests may reference synthetic-but-real staging ids.
/playwright-report/
/test-results/
/.orbita-demo-local/
/e2e/.manifests
# Diario de execucao do seed: traz ids reais de usuarios e organizacoes
# criados no projeto compartilhado. Fica em disco para a retomada e a limpeza,
# nunca no repositorio.
e2e/.diarios/
e2e/.manifests/
