{
  "name": "orbita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "node scripts/check-lint-ratchet.mjs",
    "typecheck": "tsc --noEmit",
    "aislop": "node scripts/check-aislop-ratchet.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "audit:check": "npm audit --omit=dev --audit-level=high",
    "db:drift:check": "node scripts/check-database-drift.mjs",
    "db:catalog:write": "node scripts/database-catalog.mjs --write-reference",
    "db:catalog:rebuild": "node scripts/regenerar-catalogo.mjs",
    "db:ledger:write": "node scripts/database-ledger.mjs --write",
    "db:remoto:status": "node scripts/migracoes-remotas.mjs",
    "db:remoto:aplicar": "node scripts/migracoes-remotas.mjs --aplicar",
    "storage:status": "node scripts/storage-bucket-produto-imagens.mjs",
    "storage:aplicar": "node scripts/storage-bucket-produto-imagens.mjs --aplicar",
    "boundaries:check": "node scripts/check-module-boundaries.mjs",
    "build:artifact:check": "node scripts/check-build-artifact.mjs .next",
    "deploy:readiness": "node scripts/check-deploy-readiness.mjs",
    "test:backup": "node scripts/test-backup-restore.mjs",
    "supabase:sync:rehearsal": "node scripts/supabase-sync-rehearsal.mjs",
    "test": "vitest run",
    "test:db": "node scripts/test-database-lab.mjs && node scripts/test-database-concurrency.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:list": "playwright test --list",
    "e2e:seed": "ts-node --transpile-only --project e2e/tsconfig.seed.json e2e/seed/run-seed.ts",
    "e2e:cleanup": "ts-node --transpile-only --project e2e/tsconfig.seed.json e2e/seed/run-cleanup.ts --",
    "verificar:bling": "node scripts/verificar-jornada-bling.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "stripe": "22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aislop": "^0.14.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^25.0.1",
    "supabase": "2.114.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
