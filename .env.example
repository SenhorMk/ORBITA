# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only configuration
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes encoded as 64 hexadecimal characters.
# Cifra as credenciais de integracao em repouso. Sem ela, salvar as credenciais
# do Bling falha com HTTP 500.
ENCRYPTION_KEY=

# Origem publica estavel da aplicacao (esquema + host, sem caminho).
# Monta a URL de retorno do OAuth do Bling, que e cadastrada UMA VEZ dentro do
# aplicativo no Bling. Nunca use uma URL de preview da Vercel: ela muda a cada
# deploy, e o cookie da transacao OAuth fica preso ao host onde o fluxo comecou,
# entao iniciar numa origem e receber o retorno em outra falha sempre.
# Se ausente, o app cai em STRIPE_APP_BASE_URL, que nomeia a mesma origem.
APP_BASE_URL=

# Bling: as credenciais do aplicativo NAO vem daqui.
# Cada organizacao registra Client ID e Secret na tela de Integracoes; eles sao
# guardados cifrados por organizacao (`credenciais_integracao`). As variaveis
# abaixo existem apenas como semente de desenvolvimento e sao lidas somente por
# `GET /api/config`.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Removidas no Ticket 30b, porque nenhum codigo as le e elas induziam ao erro:
#   BLING_API_KEY            era um fallback global que fazia uma organizacao
#                            sem OAuth concluido parecer conectada
#   NEXT_PUBLIC_BLING_API_KEY  variavel publica com nome de segredo, valor morto
#   BLING_WEBHOOK_SECRET     o segredo do webhook vive no cofre, por conexao

# Chatwoot server-only integration configuration
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# O nome real da chave de cifra e ENCRYPTION_KEY, declarada acima.
# `INTEGRATION_ENCRYPTION_KEY` foi removida no Ticket 30b: nenhum codigo a lia,
# e quem a preenchia acreditava ter configurado a cifra das credenciais.

# Stripe server-only billing configuration (see docs/integrations/stripe-contract.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Single allowlisted origin used to build checkout/portal return URLs; the
# client only ever supplies a relative path within this origin.
STRIPE_APP_BASE_URL=
# Server-side plan -> Price ID allowlist. The client never supplies a Price ID.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
# Feature flag gating new checkout/portal session creation. Defaults to false;
# webhook processing and reconciliation stay active regardless of this flag.
STRIPE_CHECKOUT_ENABLED=false

# Local behavior
MOCK_MODE=false
