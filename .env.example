# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only configuration
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes encoded as 64 hexadecimal characters
ENCRYPTION_KEY=

# Bling server-only integration configuration
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_API_KEY=
BLING_WEBHOOK_SECRET=

# Public Bling identifier used by browser-side configuration; never put a secret here
NEXT_PUBLIC_BLING_API_KEY=

# Chatwoot server-only integration configuration
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# Shared key used to encrypt provider credentials at rest
INTEGRATION_ENCRYPTION_KEY=

# Stripe server-only billing configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local behavior
MOCK_MODE=false
